# Vector Database Configuration
VECTORDB_PROVIDER=qdrant                    # qdrant or chroma
VECTORDB_URL=http://localhost:6333          # Qdrant URL
VECTORDB_API_KEY=                           # Optional API key
VECTORDB_COLLECTION=spark-rag               # Collection name

# Embedding Configuration
EMBEDDING_PROVIDER=ollama                   # ollama, openai, or local
EMBEDDING_MODEL=nomic-embed-text            # Model name
EMBEDDING_API_KEY=                          # OpenAI API key if using OpenAI
EMBEDDING_BATCH_SIZE=32                     # Batch size for embeddings

# LLM Configuration
LLM_PROVIDER=ollama                         # ollama, openai, azure, claude
LLM_URL=http://localhost:11434              # Ollama URL
LLM_MODEL=mistral                           # Model name
LLM_API_KEY=                                # API key if using cloud provider
LLM_MAX_TOKENS=2048                         # Maximum tokens
LLM_TEMPERATURE=0.7                         # Temperature (0-1)

# Server Configuration
SERVER_PORT=8080                            # API port
SERVER_HOST=0.0.0.0                         # Bind address

# Logging
LOG_LEVEL=info                              # debug, info, warn, error
LOG_JSON=false                              # JSON logging

# Document Ingestion
INGESTOR_WATCH_DIR=./data                   # Directory to watch
INGESTOR_CHECKPOINT=.ingestor.json          # Checkpoint file
SKIP_EXISTING=true                          # Skip already indexed files

# Chunking
CHUNK_SIZE=512                              # Chunk size in characters
CHUNK_OVERLAP=50                            # Overlap between chunks

# For OpenAI
# EMBEDDING_API_KEY=sk-...
# EMBEDDING_MODEL=text-embedding-3-small
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4-turbo-preview

# For Azure OpenAI
# LLM_URL=https://<your-resource>.openai.azure.com/
# LLM_MODEL=<deployment-name>
# LLM_API_KEY=<api-key>
