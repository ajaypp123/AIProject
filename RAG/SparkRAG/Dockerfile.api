FROM golang:1.21-alpine AS builder

WORKDIR /app/api

COPY api/go.mod api/go.sum ./

RUN go mod download

COPY api/ .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o spark-rag-api .

FROM alpine:latest

RUN apk --no-cache add ca-certificates curl

WORKDIR /app

COPY --from=builder /app/api/spark-rag-api .

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/health || exit 1

USER nobody

CMD ["./spark-rag-api"]
