FROM golang:1.21-alpine AS builder

WORKDIR /app/api

COPY api/go.mod api/go.sum ./

RUN go mod download

COPY api/ .

RUN CGO_ENABLED=0 GOOS=linux go build -a -installsuffix cgo -o spark-rag-api .

FROM alpine:3.22

RUN apk add --no-cache \
    bash \
    curl \
    jq \
    busybox-extras \
    bind-tools \
    iputils \
    procps \
    ca-certificates

WORKDIR /app

COPY --from=builder /app/api/spark-rag-api .

RUN chmod +x /app/spark-rag-api

EXPOSE 8080

USER nobody

CMD ["/app/api/spark-rag-api"]
