FROM python:3.11-slim

WORKDIR /app

# Install dependencies
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy requirements
COPY ingestor/requirements.txt .

# Install Python dependencies
RUN pip install --no-cache-dir \
    fastapi \
    uvicorn \
    sentence-transformers \
    && pip install --no-cache-dir -r requirements.txt

# Copy embedding service
COPY ingestor/embedding_service.py .

# Set environment variables
ENV MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2 \
    PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8000

# Health check
HEALTHCHECK --interval=10s --timeout=5s --retries=5 \
    CMD curl -f http://localhost:8000/health || exit 1

# Start service
CMD ["python", "embedding_service.py", "--model", "${MODEL_NAME}", "--port", "8000", "--host", "0.0.0.0"]
